+                   .EXTENDED_POLL_ACK(EXTENDED_POLL_ACK)) enhanced (
+ .CLK_50M(CLK_50M), .ENABLE(ENABLE), .REPOLL_OFF(REPOLL_OFF), .IO_LATCH_IN(IO_LATCH_IN),
+ .IO_DATA_IN(IO_DATA_IN), .LLAPI_SYNC(LLAPI_SYNC),
+ .IO_LATCH_OUT(IO_LATCH_OUT), .IO_DATA_OUT(IO_DATA_OUT),
+ .LLAPI_EN(LLAPI_EN), .LLAPI_TYPE(LLAPI_TYPE), .LLAPI_MODES(LLAPI_MODES),
+ .LLAPI_BUTTONS(LLAPI_BUTTONS), .LLAPI_ANALOG(LLAPI_ANALOG),
+ .CMD_RAW(1'b0), .CMD_TX_LENGTH(5'd0), .CMD_RX_LENGTH(4'd0), .CMD_TX_DATA(192'd0),
+ .CMD_VALID(1'b0), .CMD_OPCODE(8'd0), .CMD_PAYLOAD(16'd0),
+ .STATUS_VALID(STATUS_VALID), .STATUS_UPDATE(STATUS_UPDATE), .LINK_FAULT(LINK_FAULT),
+ .TYPE_CHANGED(TYPE_CHANGED), .LAST_FAULT_REASON(LAST_FAULT_REASON), .poll_timing_us(poll_timing_us),
+ .CMD_READY(), .CMD_DONE(), .CMD_ERROR(), .CMD_REPLY(), .CMD_REPLY_LENGTH()
+ );
+endmodule
