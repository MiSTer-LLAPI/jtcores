+HCP3-,LLAPI Driver: 1.2;
+{{ if .JTFRAME_ENHANCED_FIXED_OPTIONS }} HCP3-,Immediate Repoll: On;
+{{ else }} HCP3OO,Immediate Repoll,On,Off; {{ end }}
+{{ else }}
+{{ if .JTFRAME_LLAPI_AUTOFIRE_OPTIONS }} D7O8,Autofire,Off,On; D7O9,Autofire mode,Hold,Toggle; {{ end }}
+{{ end }}
+{{ else }}
 {{ if .JTFRAME_UART }}
     {{ if .JTFRAME_NO_DB15 }}       o6,User port,Off,UART; {{ else }}
                                     o56,User port,Off,DB15 Joystick,UART; {{ end }}
     {{ else }}                      o5,User port,Off,DB15 Joystick; {{ end }}
 {{ if not .JTFRAME_NO_DB15 }}       H8oT,DB15 OSD Combo,Start+Button 3,Off; {{ end }}
-{{ if .JTFRAME_CREDITS }} OC,Show credits in pause,On,Off; {{ end }}
+{{ end }}
+{{ if .JTFRAME_CREDITS }}
+{{ if and .JTFRAME_ENHANCED_CONTROLS .JTFRAME_ENHANCED_FIXED_OPTIONS }} OC,Show credits on pause,Off,On;
+{{ else if .JTFRAME_CREDITS_DEFAULT_OFF }} OC,Show credits in pause,Off,On;
+{{ else }} OC,Show credits in pause,On,Off; {{ end }}
+{{ end }}
 R0,Reset;
+{{ if .JTFRAME_ENHANCED_CONTROLS }}
+-,Enhanced Core: 2.1;
+{{ if not .JTFRAME_LLAPI_HIDE_DIAGNOSTICS }}
+HCP4,LLAPI DIAGNOSTICS;
+P4-,LLAPI DRIVER: V1.2;
+P4-,LAST FAULT P1: {{printf "\020"}}  P2: {{printf "\176"}};
+P4-,0 NONE / 1 TIMEOUT;
+P4-,2 REJECTED / 3 RX TIMEOUT;
+{{ if .JTFRAME_LLAPI_POLL_DIAG }}
+HCP5,P1 TIMING;
+P5-,TIMES IN MICROSECONDS;
+P5-,POLL TO READY: {{printf "\177\177\177\177\177"}};
+P5-,READY TO STATUS: {{printf "\177\177\177\177\177"}};
+P5-,REPORT TO NEXT POLL: {{printf "\177\177\177\177\177"}};
+P5-,REPORT TO VBLANK: {{printf "\177\177\177\177\177"}};
+P5-,----- AWAITING SAMPLE;
+{{ end }}
+{{ end }}
+{{ end }}
 {{ with .MISTER_EXTRA }} {{ . }} {{ end }}
 V,v{{ .JTFRAME_COMMIT }};
