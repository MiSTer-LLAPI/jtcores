+wire [137:0] loss_selected=show_two ? {loss_pixels[137:96],two_glyph,loss_pixels[77:0]} : loss_pixels;
+wire [101:0] ready_selected=show_two ? {ready_pixels[101:24],two_glyph,ready_pixels[5:0]} : ready_pixels;
+reg [34:0] digit;
