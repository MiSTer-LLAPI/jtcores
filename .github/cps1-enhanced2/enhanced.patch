new file mode 100644
index 0000000..696a474
--- /dev/null
+++ b/modules/jtframe/src/jtframe/cfgstr/enhanced_rom_test.go
@@ -0,0 +1,13 @@
+package cfgstr
+import("os";"strings";"testing")
+func TestEnhancedROM(t *testing.T) {
+ old,_:=os.Getwd();if err:=os.Chdir(t.TempDir());err!=nil{t.Fatal(err)};defer os.Chdir(old)
+ for _,capacity:=range []int{1024,2048}{
+  text:=strings.Repeat("A",capacity-3)+"\u0080\u00ff"
+  if err:=dump_cfgstr(text,capacity);err!=nil{t.Fatal(err)}
+  data,_:=os.ReadFile("cfgstr.hex");fields:=strings.Fields(string(data))
+  if len(fields)!=capacity||fields[capacity-3]!="80"||fields[capacity-2]!="FF"||fields[capacity-1]!="00"{t.Fatalf("bad ROM encoding or terminator: %d",len(fields))}
+  if dump_cfgstr(strings.Repeat("A",capacity),capacity)==nil{t.Fatal("overflow accepted")}
+ }
+ if dump_cfgstr("\u0100",1024)==nil{t.Fatal("non-byte accepted")}
+}
