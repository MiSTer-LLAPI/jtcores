+// SPDX-License-Identifier: GPL-3.0-or-later
+// One physical SNAC player. Only game actions can be programmed.
+// A Start pressed alongside the action remains available for game/menu chords.
+module jtframe_snac_turbo #(parameter BUTTONS = 3)(
+    input clk, reset, selected, frame_tick, osd,
+    input [8:0] pad,
+    input [2:0] extra,
+    output [2:0] extra_fire,
+    output [6:0] game_pad,
+    output game_start,
+    output db15_menu
+);
+    localparam [5:0] ACTION_MASK =
+`ifdef JTFRAME_SNAC_TURBO_MASK
+        `JTFRAME_SNAC_TURBO_MASK;
+`else
+        (1 << BUTTONS) - 1;
+`endif
+    wire [5:0] actions = {extra, pad[6:4]};
+    wire single = |(actions & ACTION_MASK) && (actions & (actions - 6'd1)) == 0;
+    wire start = pad[7];
+    // Directions and coin can take part in the original menu/coin shortcuts.
+    wire candidate = single && !pad[8] && !pad[2];
+    reg [5:0] prev_actions, programmed;
+    reg prev_start, reserved, valid_press, prev_sample, stable_down;
+    reg [1:0] taps;
+    reg [4:0] menu_hold;
+    wire same_button = actions == prev_actions;
+    wire reserve = prev_start ? reserved : candidate && same_button;
+    wire gesture_down = start && candidate && same_button &&
+                        (!prev_start || valid_press);
+    assign game_start = start && !reserve;
+    // Original DB15 chord works immediately with Start first or both
+    // together. Holding it also opens the menu when button 3 was first.
+    assign db15_menu = start && pad[6] && (!reserve || &menu_hold);
+
+    always @(posedge clk) begin
+        if (reset || !selected || osd) begin
+            prev_actions <= 0;
+            prev_start <= 0;
+            reserved <= 0;
+            valid_press <= 0;
+            taps <= 0;
+            prev_sample <= 0;
+            stable_down <= 0;
+            menu_hold <= 0;
+            if (reset || !selected) programmed <= 0;
+        end else begin
+            prev_actions <= actions;
+            prev_start <= start;
+            if (!start || !pad[6]) menu_hold <= 0;
+            else if (frame_tick && !(&menu_hold)) menu_hold <= menu_hold + 1'b1;
+
+            if (start && !prev_start) begin
+                reserved <= candidate && same_button;
+                valid_press <= candidate && same_button;
+            end else if (!start || !same_button || !candidate) valid_press <= 0;
+
+            if (!candidate || !same_button) begin
+                taps <= 0;
+                prev_sample <= 0;
+                stable_down <= 0;
+            end else if (frame_tick) begin
+                prev_sample <= gesture_down;
+                if (gesture_down && prev_sample) stable_down <= 1;
+                if (!start && !prev_sample && stable_down) begin
+                    stable_down <= 0;
+                    if (taps == 2) begin
+                        programmed <= programmed ^ actions;
+                        taps <= 0;
+                    end else taps <= taps + 1'b1;
+                end
+            end
+        end
+    end
+
+    wire [5:0] fire;
+    genvar i;
+    generate for (i=0; i<6; i=i+1) begin : action
+        reg [1:0] phase;
+        always @(posedge clk) begin
+            if (reset || !selected || osd || !actions[i] || !programmed[i]) phase <= 0;
+            else if (frame_tick) phase <= phase + 1'b1;
+        end
+        assign fire[i] = actions[i] && (!programmed[i] || !phase[1] || game_start);
+    end endgenerate
+    assign game_pad = {fire[2:0], pad[3:0]};
+    assign extra_fire = fire[5:3];
+endmodule
