+ 1:ready_pixels=102'b100010100000100010100010100010000000100010100000100010100010100000100010000000100010110010100000001000;
+ 2:ready_pixels=102'b100010100000100010100010010100000000100010100000100010010100100000100010000000100010110010100000001000;
+ 3:ready_pixels=102'b111100111100111110100010001000000000111100100000111110001000111100111100000000100010101010111100001000;
+ 4:ready_pixels=102'b101000100000100010100010001000000000100000100000100010001000100000101000000000100010100110100000001000;
+ 5:ready_pixels=102'b100100100000100010100010001000000000100000100000100010001000100000100100000000100010100110100000000000;
+ 6:ready_pixels=102'b100010111110100010111100001000000000100000111110100010001000111110100010000000011100100010111110001000;
