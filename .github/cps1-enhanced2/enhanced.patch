+ 0:line_text="MENU: LEFT+START+FIRE   ";
+ 1,4:line_text="MENU: LEFT+START+B      ";
+ 3:line_text="MENU: START+C           ";
+ default:line_text="MENU: LEFT+START+FIRE   ";
+ endcase
+ end else if(index<104) begin
+ p2=index>=80;column=index-(p2 ? 80:56);port_info=p2 ? info[19:10] : info[9:0];
+ if(mode==0)begin
+ if(port_info[9:8]!=1)line_text=p2 ? "P2: NOT CONNECTED       " : "P1: NOT CONNECTED       ";
+ else if(port_info[7:0]==3)line_text=p2 ? "P2 COIN:R START:START   " : "P1 COIN:R START:START   ";
+ else line_text=p2 ? "P2 COIN:BTN5 START:BTN7 " : "P1 COIN:BTN5 START:BTN6 ";
+ end else if(p2 && mode!=3 && mode!=4 && mode!=6)line_text="P2: NOT AVAILABLE       ";
+ else case(mode)
+ 1:line_text="P1 COIN:L START:START   ";
+ 4,6:line_text=p2 ? "P2 COIN:SELECT START:ST " : "P1 COIN:SELECT START:ST ";
+ default:line_text=p2 ? "P2: MAPPED COIN/START   " : "P1: MAPPED COIN/START   ";
+ endcase
+ end else begin
+ column=index-104;
+ case(mode)
+ 0:line_text="AUTOFIRE: LLAPI BTN4    ";
+ 1:line_text="AUTOFIRE: A             ";
+ 4:line_text="AUTOFIRE: X             ";
+ 2:line_text="AUTOFIRE: MD3 C / MD6 X ";
+ 3:line_text="AUTOFIRE: D             ";
+ default:line_text="AUTOFIRE: UNAVAILABLE   ";
+ endcase
+ end
+end
+assign character=column<24 ? line_text[191-column*8 -:8] : 8'd32;
+endmodule
+
+
+module enhanced_info_byte(input [7:0] original,input [19:0] info,output [7:0] rendered,input [2:0] mode,input [7:0] diagnostics,input [1:0] af,input [3:0] last_fault);
+wire port_b=original>=17 && original<=31;
+wire port_a=original>=1 && original<=15;
+wire [7:0] offset=original-(port_b ? 8'd17 : 8'd1);
+wire [7:0] text_byte;
+controller_info_text u_text(port_b ? info[19:10] : info[9:0],offset[3:0],text_byte);
+wire [7:0] guide_byte;
+selected_interface_guide u_guide(mode,original[6:0],guide_byte);
+wire [7:0] shortcut_byte;
+controller_shortcut_text u_shortcut(info,original[6:0],mode,af,shortcut_byte);
+wire diagnostic_marker=original==127;
+wire [7:0] diagnostic_digit=8'd48+((diagnostics >> ((original==127 ? 3 : original-29)*2)) & 8'd3);
+// Reserved ROM markers for the two per-port latched reasons on the diagnostic page.
+wire fault_marker = original == 16 || original == 126;
+wire [1:0] reason = original == 16 ? last_fault[1:0] : last_fault[3:2];
+assign rendered=fault_marker ? (8'h30 + {6'b0,reason}) : diagnostic_marker ? diagnostic_digit : original[7] ? (original>=160 ? shortcut_byte : guide_byte) : (port_a||port_b) ? text_byte : original;
+endmodule
+`endif
+
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+// Convert four 16-bit intervals one bit per clock. All 64 clocks have elapsed
+// before the first timing marker in the configuration ROM can be requested.
+module llapi_timing_digits (
+    input clk, capture, advance,
+    input [63:0] sample,
+    output [7:0] ascii_digit
+);
+    reg [63:0] binary_words;
+    reg [5:0] bit_count;
+    reg converting = 0;
+    reg [19:0] bcd;
+    reg [79:0] digits = {80{1'b1}};
+
+    integer digit;
+    reg [19:0] adjusted;
+    always @* begin
+        adjusted = bcd;
+        for (digit = 0; digit < 5; digit = digit + 1)
+            if (bcd[digit*4+:4] >= 5)
+                adjusted[digit*4+:4] = bcd[digit*4+:4] + 4'd3;
+    end
+    wire [19:0] shifted = {adjusted[18:0], binary_words[63]};
+    wire [3:0] first = digits[79:76];
+    assign ascii_digit = first == 4'hf ? 8'h2d : {4'h3, first};
+
+    always @(posedge clk) begin
+        if (capture) begin
+            binary_words <= sample;
+            bit_count <= 0;
+            bcd <= 0;
+            converting <= 1;
+        end else if (converting) begin
+            binary_words <= {binary_words[62:0], 1'b0};
+            bit_count <= bit_count + 1'b1;
+            if (bit_count[3:0] == 4'hf) begin
+                // The driver reserves 0xffff to mean no sample.
+                digits <= {digits[59:0], shifted == 20'h65535 ? 20'hfffff : shifted};
+                bcd <= 0;
+            end else bcd <= shifted;
+            if (bit_count == 6'd63) converting <= 0;
+        end else if (advance) begin
+            digits <= {digits[75:0], 4'hf};
+        end
+    end
+endmodule
+`endif
