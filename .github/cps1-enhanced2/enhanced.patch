+default:digit=0;
+endcase
+wire loss_ink=y>=32 && y<46 && column<138 && loss_selected[137-column];
+wire [8:0] ready_column=(x-10)>>1;
+wire ready_ink=y>=32 && y<46 && x>=10 && ready_column<102 && ready_selected[101-ready_column];
+wire [8:0] dx=(x-92)>>3,dy=(y-80)>>3;
+wire digit_ink=x>=92 && y>=80 && dx<5 && dy<7 && digit[34-(dy*5+dx)];
