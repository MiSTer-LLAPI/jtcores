+// SPDX-License-Identifier: GPL-3.0-or-later
+// Derive active-area coordinates without changing the video pipeline latency.
+module paused_scroll_video #(parameter COLORW=4, WIDTH=256, HEIGHT=224)(
+ input clk,rst,pxl_cen,hactive,vactive,paused,osd_active,
+ input vertical,reverse,
+ input [1:0] countdown,
+ input wire [1:0] players,
+ input [3*COLORW-1:0] rgb_in,
+ output [3*COLORW-1:0] rgb_out
+);
+reg [8:0] hpos=0,vpos=0,phase=0;
+reg last_h=0,last_v=0;
+always @(posedge clk) begin
+ if(rst)begin hpos<=0;vpos<=0;phase<=0;last_h<=0;last_v<=0;end
+ else if(pxl_cen)begin
+  last_h<=hactive;last_v<=vactive;
+  if(!hactive)hpos<=0;else hpos<=hpos+1'b1;
+  if(!vactive)vpos<=0;else if(!hactive && last_h)vpos<=vpos+1'b1;
+  if(!paused)phase<=0;else if(vactive && !last_v)phase<=phase+1'b1;
+ end
+end
+wire [8:0] display_x=vertical ? (reverse ? vpos : HEIGHT-1-vpos) : hpos;
+wire [8:0] display_y=vertical ? (reverse ? WIDTH-1-hpos : hpos) : vpos;
+paused_scroll #(.COLORW(COLORW)) strip(
+ .paused(paused && hactive && vactive && !rst),.osd_active(osd_active),
+ .countdown(countdown),.players(players),.x(display_x),.y(display_y),.phase(phase),.rgb_in(rgb_in),.rgb_out(rgb_out));
+endmodule
+
+`endif
