diff --git a/modules/jtframe/target/mister/hdl/jtframe_llapi_arcade.sv b/modules/jtframe/target/mister/hdl/jtframe_llapi_arcade.sv
new file mode 100644
index 0000000..4714316
--- /dev/null
+++ b/modules/jtframe/target/mister/hdl/jtframe_llapi_arcade.sv
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Experimental JTFRAME bridge for the MiSTer-LLAPI arcade protocol.
+// Protocol implementation and arcade button IDs originate in
+// MiSTer-LLAPI/Arcade-IremM62_MiSTer, commit 4d637039.
+module jtframe_llapi_arcade #(
+    parameter BUTTONS=3, LOSS_MS=1000, AF_TWO_BUTTONS=(BUTTONS<3)
+)(
+    input clk_50, clk_sys, rst, vblank, osd_active, enable, repoll_off,
+    input [6:0] user_in,
+    output logic [6:0] user_out,
+    input [15:0] usb1, usb2,
+    output [15:0] joy1, joy2,
+    output [3:0] start, coin,
+    output osd_request,
+    output [1:0] autofire_hold,
+    output [1:0] connected
+`ifdef JTFRAME_ENHANCED_CONTROLS
+    ,input loss_resume
+    ,output loss_paused
+    ,output [1:0] loss_players
+    ,output [1:0] loss_countdown
+    ,input info_clk
+    ,output [19:0] controller_info
+    ,output [7:0] link_diagnostics
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+    ,output [63:0] poll_timing_us
+`endif
+    ,output [3:0] last_fault_reason
+    ,output [1:0] type_changed
+`endif
+);
+    wire [31:0] buttons1, buttons2;
+    wire [7:0] type1,type2;
+    wire en1,en2,latch1,data1,latch2,data2;
+    wire update1,update2,fault1,fault2;
+`ifdef JTFRAME_ENHANCED_CONTROLS
+    wire [1:0] changed50;
+    wire [1:0] last_fault1,last_fault2;
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+    wire [63:0] timing50;
+`endif
+`endif
+    (* async_reg="true" *) reg rst50_meta=1, rst50_sync=1;
+    (* async_reg="true" *) reg osd50_meta=0, osd50_sync=0;
+    reg seen1=0,seen2=0;
+    wire valid1;
+    wire valid2;
+    reg repoll_off_meta = 0, repoll_off_sync = 0;
+    always @(posedge clk_50) begin
+        // Old settings may still have bit 24 set. Only the fixed Enhanced
+        // policy ignores it; both P1 and P2 consume this synchronized signal.
+`ifdef JTFRAME_ENHANCED_CONTROLS
+`ifdef JTFRAME_ENHANCED_FIXED_OPTIONS
+        repoll_off_meta <= 1'b0;
+`else
+        repoll_off_meta <= repoll_off;
+`endif
+`else
+        repoll_off_meta <= repoll_off;
+`endif
+        repoll_off_sync <= repoll_off_meta;
+    end
+
+    always @(posedge clk_50) begin
+        rst50_meta<=rst; rst50_sync<=rst50_meta;
+        osd50_meta<=osd_active; osd50_sync<=osd50_meta;
+        if(rst50_sync) begin seen1<=0; seen2<=0; end
+        else begin
+            if(en1 && type1!=8'hff && |buttons1) seen1<=1;
+            if(en2 && type2!=8'hff && |buttons2) seen2<=1;
+        end
+    end
+    // Same physical USER port wiring and enable polarity as the arcade cores.
+    always_comb begin
+        user_out=7'h7f;
+        user_out[0]=latch1; user_out[1]=data1;
+        user_out[2]=osd50_sync;
+        user_out[4]=latch2; user_out[5]=data2;
+    end
+    LLAPI #(.EXTENDED_POLL_ACK(1)) u_port1(.CLK_50M(clk_50),.LLAPI_SYNC(vblank),.REPOLL_OFF(repoll_off_sync),
+        .IO_LATCH_IN(user_in[0]),.IO_LATCH_OUT(latch1),
+        .IO_DATA_IN(user_in[1]),.IO_DATA_OUT(data1),.ENABLE(enable && ~osd50_sync),
+        .LLAPI_BUTTONS(buttons1),.LLAPI_ANALOG(),.LLAPI_TYPE(type1),
+        .LLAPI_MODES(),.LLAPI_EN(en1),.STATUS_VALID(valid1),.STATUS_UPDATE(update1),.LINK_FAULT(fault1)
+`ifdef JTFRAME_ENHANCED_CONTROLS
+        ,.TYPE_CHANGED(changed50[0]),.LAST_FAULT_REASON(last_fault1)
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+        ,.poll_timing_us(timing50)
+`endif
+`endif
+    );
+    LLAPI u_port2(.CLK_50M(clk_50),.LLAPI_SYNC(vblank),.REPOLL_OFF(repoll_off_sync),
+        .IO_LATCH_IN(user_in[4]),.IO_LATCH_OUT(latch2),
+        .IO_DATA_IN(user_in[5]),.IO_DATA_OUT(data2),.ENABLE(enable && ~osd50_sync),
+        .LLAPI_BUTTONS(buttons2),.LLAPI_ANALOG(),.LLAPI_TYPE(type2),
+        .LLAPI_MODES(),.LLAPI_EN(en2),.STATUS_VALID(valid2),.STATUS_UPDATE(update2),.LINK_FAULT(fault2)
+`ifdef JTFRAME_ENHANCED_CONTROLS
+        ,.TYPE_CHANGED(changed50[1]),.LAST_FAULT_REASON(last_fault2)
+`endif
+    );
+`ifdef JTFRAME_ENHANCED_CONTROLS
+    (* async_reg="true" *) reg resume_meta=0,resume_sync=0;
+    reg resume_old=0;
+    always @(posedge clk_50) begin
+        resume_meta<=loss_resume; resume_sync<=resume_meta; resume_old<=resume_sync;
+    end
+    // ID changes are separated by at least one full serial status transaction.
+    // Toggle each bit so even a single 50 MHz strobe reaches the game clock.
+    reg [1:0] change_toggle=0,change_previous=0;
+    (* async_reg="true" *) reg [1:0] change_meta=0,change_sync=0;
+    always @(posedge clk_50) begin
+        if(rst50_sync) change_toggle<=0;
+        else change_toggle<=change_toggle ^ changed50;
+    end
+    always @(posedge clk_sys) begin
+        if(rst) begin change_meta<=0;change_sync<=0;change_previous<=0;end
+        else begin
+            change_meta<=change_toggle;
+            change_sync<=change_meta;
+            change_previous<=change_sync;
+        end
+    end
+    assign type_changed=change_sync ^ change_previous;
+    wire loss50;
+    wire [1:0] countdown50;
+    wire [1:0] lost_ports,rediscover_unused;
+    controller_loss_clocked #(.LOSS_MS(LOSS_MS)) loss_policy(
+        .clk(clk_50),.rst(rst50_sync),.enable(enable),.observe(!osd50_sync),
+        .resume(resume_sync ^ resume_old),.connected({valid2,valid1}),
+        .paused(loss50),.countdown(countdown50),.lost(lost_ports),.rediscover(rediscover_unused));
+    // Bundled mailbox: source holds all three state bits until destination acknowledges.
+    reg [4:0] loss_mailbox=0;
+    reg loss_request=0,loss_ack=0;
+    (* async_reg="true" *) reg ack_meta=0,ack_sync=0,req_meta=0,req_sync=0;
+    reg [4:0] loss_snapshot=0;
+    always @(posedge clk_50) begin
+        ack_meta<=loss_ack;ack_sync<=ack_meta;
+        if(rst50_sync) begin loss_mailbox<=0;loss_request<=0;ack_meta<=0;ack_sync<=0;end
+        else if(loss_request==ack_sync && loss_mailbox!={lost_ports,loss50,countdown50}) begin
+            loss_mailbox<={lost_ports,loss50,countdown50};loss_request<=~loss_request;
+        end
+    end
+    always @(posedge clk_sys) begin
+        req_meta<=loss_request;req_sync<=req_meta;
+        if(rst) begin req_meta<=0;req_sync<=0;loss_ack<=0;loss_snapshot<=0;end
+        else if(req_sync!=loss_ack) begin loss_snapshot<=loss_mailbox;loss_ack<=req_sync;end
+    end
+    assign loss_players=loss_snapshot[4:3];
+    assign loss_paused=loss_snapshot[2];
+    assign loss_countdown=loss_snapshot[1:0];
+`endif
+    // Button levels are slow asynchronous inputs, not a streamed data bus.
+    // Constrain only the first sampling stages; retain timing between stages.
+    (* async_reg="true" *) reg [31:0] buttons1_meta=0,buttons1_sync=0;
+    (* async_reg="true" *) reg [31:0] buttons2_meta=0,buttons2_sync=0;
+    (* async_reg="true" *) reg valid1_meta=0,valid1_sync=0;
+    (* async_reg="true" *) reg valid2_meta=0,valid2_sync=0;
+    (* async_reg="true" *) reg saturn1_meta=0,saturn1_sync=0,saturn2_meta=0,saturn2_sync=0;
+    always @(posedge clk_sys) begin
+        if(rst) begin
+            saturn1_meta<=0;saturn1_sync<=0;saturn2_meta<=0;saturn2_sync<=0;
+            buttons1_meta<=0; buttons1_sync<=0;
+            buttons2_meta<=0; buttons2_sync<=0;
+            valid1_meta<=0; valid1_sync<=0;
+            valid2_meta<=0; valid2_sync<=0;
+        end else begin
+            saturn1_meta<=valid1 && type1==8'd3;saturn1_sync<=saturn1_meta;
+            saturn2_meta<=valid2 && type2==8'd3;saturn2_sync<=saturn2_meta;
+            buttons1_meta<=buttons1; buttons1_sync<=buttons1_meta;
+            buttons2_meta<=buttons2; buttons2_sync<=buttons2_meta;
+            valid1_meta<=valid1; valid1_sync<=valid1_meta;
+            valid2_meta<=valid2; valid2_sync<=valid2_meta;
+        end
+    end
+assign connected={valid2_sync,valid1_sync};
+`ifdef JTFRAME_ENHANCED_CONTROLS
+    // Freeze on the same synchronized OSD signal that disables transport.
+    // Driver nonblocking reset cannot erase the preceding captured identity.
+    llapi_link_diagnostics u_link_diagnostics(
+        .clk(clk_50),.dst_clk(info_clk),.rst(rst50_sync),
+        .observe(enable && !osd50_sync),.updates({update2,update1}),
+        .faults({fault2,fault1}),.reasons({last_fault2,last_fault1}),
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+        .timing_us(timing50),.timing_snapshot(poll_timing_us),
+`endif
+        .snapshot(link_diagnostics),.last_fault(last_fault_reason));
+    controller_info_snapshot u_controller_info(
+        .src_clk(clk_50),.dst_clk(info_clk),.rst(rst),
+        .freeze(osd50_sync),.observe(enable),
+        .connected({valid2,valid1}),.type_a(type1),.type_b(type2),
+        .snapshot(controller_info));
+`endif
+
+`ifdef JTFRAME_LLAPI_HOLD_AUTOFIRE
+    // Bit3 is unused by the existing arcade map (bits0..2 are game buttons).
+    // Current SNES reference maps it to X; Genesis six-button maps it to Y.
+    // Keep the already-tested bit2 autofire alias only in two-button cores.
+    assign autofire_hold={valid2_sync && (buttons2_sync[3] || (AF_TWO_BUTTONS && buttons2_sync[2])),
+                          valid1_sync && (buttons1_sync[3] || (AF_TWO_BUTTONS && buttons1_sync[2]))};
+`else
+    assign autofire_hold=0;
+`endif
+    jtframe_llapi_arcade_map #(.BUTTONS(BUTTONS)) u_map(
+        .buttons1(buttons1_sync),.buttons2(buttons2_sync),
+        .saturn1(saturn1_sync),.saturn2(saturn2_sync),
+        .valid1(valid1_sync),.valid2(valid2_sync),.osd_active(osd_active),
+        .usb1(usb1),.usb2(usb2),.joy1(joy1),.joy2(joy2),
+        .start(start),.coin(coin),.osd_request(osd_request));
+endmodule
+
+module jtframe_llapi_arcade_map #(parameter BUTTONS=3)(
+    input [31:0] buttons1,buttons2,
+    input valid1,valid2,osd_active,
+    input tri0 saturn1,saturn2,
+    input [15:0] usb1,usb2,
+    output [15:0] joy1,joy2,
+    output [3:0] start,coin,
+    output osd_request
+);
+    wire [31:0] p1=valid1 ? buttons1 : 32'd0;
+    wire [31:0] p2=valid2 ? buttons2 : 32'd0;
+    assign osd_request=(p1[26]&p1[5]&p1[0]) | (p2[26]&p2[5]&p2[0]);
+    wire inhibit=osd_active | osd_request;
+    function automatic [15:0] game_buttons(input [31:0] p, input saturn_pad);
+        integer n;
+        begin
+            game_buttons=0;
+            game_buttons[3:0]=p[27:24]; // up, down, left, right
+            for(n=0;n<3;n=n+1)
+                if(n<BUTTONS) game_buttons[4+n]=p[n];
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+            if(BUTTONS >= 4) game_buttons[7] = p[3];
+            if(BUTTONS >= 5) game_buttons[8] = saturn_pad ? p[8] : p[6];
+            if(BUTTONS >= 6) game_buttons[9] = saturn_pad ? p[9] : p[7];
+`endif
+        end
+    endfunction
+    // Preserve the existing arcade allocation: one LLAPI socket reserves
+    // its player slot; USB player 1 fills the other slot.
+    assign joy1=valid1 ? (inhibit ? 16'd0 : game_buttons(p1,saturn1)) : usb1;
+    assign joy2=valid2 ? (inhibit ? 16'd0 : game_buttons(p2,saturn2)) :
+                         (valid1 ? usb1 : usb2);
+    // Arcade convention: button 5 starts P1 and button 6 starts P2,
+    // from either socket. Button 4 is that socket's coin input.
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+    assign start=inhibit ? 4'd0 : {2'b0,p2[5],p1[5]};
+`else
+    assign start=inhibit ? 4'd0 : {2'b0,(!saturn1 && p1[6]) | (saturn2 ? p2[5] : p2[6]),p1[5] | (!saturn2 && p2[5])};
+`endif
+    assign coin=inhibit ? 4'd0 : {2'b0,(saturn2 ? p2[6] : p2[4]),(saturn1 ? p1[6] : p1[4])};
+endmodule
+
+
+`ifdef JTFRAME_ENHANCED_CONTROLS
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Optional core UI helper, not part of the LLAPI transport driver.
+// Shared reset required. freeze must assert before transport ENABLE is cleared.
+module controller_info_snapshot(
+ input src_clk,dst_clk,rst,freeze,observe,
+ input [1:0] connected,
+ input [7:0] type_a,type_b,
+ output reg [19:0] snapshot=0
+);
+// Per-port state: 00 never seen, 01 last connected, 10 observed disconnect.
+reg [19:0] latest=0,mailbox=0;
+reg request=0,ack=0;
+(* async_reg="true" *) reg ack_meta=0,ack_sync=0,req_meta=0,req_sync=0;
+reg [19:0] next_info;
+always @* begin
+ next_info=latest;
+ if(observe && !freeze) begin
+  if(connected[0]) next_info[9:0]={2'b01,type_a};
+  else if(latest[9:8]!=0) next_info[9:8]=2'b10;
+  if(connected[1]) next_info[19:10]={2'b01,type_b};
+  else if(latest[19:18]!=0) next_info[19:18]=2'b10;
+ end
+end
+always @(posedge src_clk) begin
+ ack_meta<=ack;ack_sync<=ack_meta;
+ if(rst) begin latest<=0;mailbox<=0;request<=0;ack_meta<=0;ack_sync<=0;end
+ else begin
+  latest<=next_info;
+  // Hold bundled data until destination acknowledges; updates coalesce.
+  if(request==ack_sync && mailbox!=next_info) begin
+   mailbox<=next_info;request<=~request;
+  end
+ end
+end
+always @(posedge dst_clk) begin
+ req_meta<=request;req_sync<=req_meta;
+ if(rst) begin snapshot<=0;ack<=0;req_meta<=0;req_sync<=0;end
+ else if(req_sync!=ack) begin snapshot<=mailbox;ack<=req_sync;end
+end
+endmodule
+`endif
+
+`ifdef JTFRAME_ENHANCED_CONTROLS
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Core policy, not transport: confirmed loss pauses until explicit acknowledgement.
+// ms_tick is a one-clock strobe from a wall-time millisecond timebase.
+// Observe must be low when polling is intentionally suspended or interface changes.
+module controller_loss_pause #(parameter LOSS_MS=1000)(
+ input clk,rst,enable,observe,ms_tick,resume,
+ input [1:0] connected,
+ output reg paused=0,
+ output reg [1:0] lost=0,rediscover=0,countdown=0
+);
+localparam W=LOSS_MS<2?1:$clog2(LOSS_MS+1);
+reg[1:0] armed=0;
+reg[W-1:0] count[0:1];
+reg[9:0] second_ms=0;
+wire[1:0] missing=armed & ~connected;
+integer p;
+always @(posedge clk) begin
+ rediscover<=0;
+ if(rst || !enable)begin
+  paused<=0;lost<=0;armed<=0;countdown<=0;second_ms<=0;
+  count[0]<=0;count[1]<=0;
+ end else if(!observe)begin
+  count[0]<=0;count[1]<=0;countdown<=0;second_ms<=0;
+ end else begin
+  armed<=armed|connected;
+  if(paused)begin
+   lost<=lost|missing;
+   if(|missing)begin countdown<=0;second_ms<=0;end
+   else if(countdown==0)begin countdown<=3;second_ms<=0;end
+   else if(ms_tick)begin
+    if(second_ms==999)begin
+     second_ms<=0;countdown<=countdown-1'b1;
+     if(countdown==1)begin paused<=0;lost<=0;count[0]<=0;count[1]<=0;end
+    end else second_ms<=second_ms+1'b1;
+   end
+  end else for(p=0;p<2;p=p+1)begin
+   if(connected[p]) count[p]<=0;
+   else if(armed[p] && ms_tick)begin
+    if(count[p]==LOSS_MS-1)begin
+     paused<=1;lost[p]<=1;rediscover[p]<=1;count[p]<=0;
+    end else count[p]<=count[p]+1'b1;
+   end
+  end
+ end
+end
+endmodule
+
+// SPDX-License-Identifier: GPL-3.0-or-later
+// All inputs/outputs belong to clk. Integrator must synchronize crossings.
+module controller_loss_clocked #(parameter CLK_HZ=50000000, LOSS_MS=1000)(
+ input clk,rst,enable,observe,resume,
+ input [1:0] connected,
+ output paused,
+ output [1:0] lost,rediscover,
+ output [1:0] countdown
+);
+localparam TICKS=CLK_HZ/1000;
+localparam W=TICKS<2 ? 1 : $clog2(TICKS);
+reg [W-1:0] divider=0;
+wire ms_tick=divider==TICKS-1;
+always @(posedge clk) begin
+ if(rst || !enable || ms_tick) divider<=0;
+ else divider<=divider+1'b1;
+end
+controller_loss_pause #(.LOSS_MS(LOSS_MS)) policy(.*);
+endmodule
+
+`endif
+
+`ifdef JTFRAME_ENHANCED_CONTROLS
+// Core-only bounded diagnostic counters. A fault is not proof of physical unplug.
+// Counts survive OSD polling suspension; reset with the core. 3 means 3 or more.
+module llapi_link_diagnostics(input clk,dst_clk,rst,observe,
+ input [1:0] updates,faults,output wire [7:0] snapshot,
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+ input [63:0] timing_us,output wire [63:0] timing_snapshot,
+`endif
+ input [3:0] reasons,output wire [3:0] last_fault);
+reg [7:0] counts=0;
+reg [3:0] retained_reason=0;
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+localparam [75:0] EMPTY = {64'hFFFF_FFFF_FFFF_FFFF, 12'd0};
+wire [75:0] next_sample = {timing_us, retained_reason, counts};
+reg [75:0] mailbox=EMPTY,received=EMPTY;
+assign {timing_snapshot,last_fault,snapshot}=received;
+`else
+localparam [11:0] EMPTY=0;
+wire [11:0] next_sample={retained_reason,counts};
+reg [11:0] mailbox=EMPTY,received=EMPTY;
+assign {last_fault,snapshot}=received;
+`endif
+reg request=0,ack=0;
+(* async_reg="true" *) reg ack_meta=0,ack_sync=0,req_meta=0,req_sync=0;
+integer p;
+always @(posedge clk) begin
+ ack_meta<=ack;ack_sync<=ack_meta;
+ if(rst) begin counts<=0;retained_reason<=0;mailbox<=EMPTY;request<=0;ack_meta<=0;ack_sync<=0;end
+ else begin
+  for(p=0;p<2;p=p+1) if(observe) begin
+   if(updates[p] && counts[p*4+:2]!=3) counts[p*4+:2]<=counts[p*4+:2]+1'b1;
+   if(faults[p] && counts[p*4+2+:2]!=3) counts[p*4+2+:2]<=counts[p*4+2+:2]+1'b1;
+  end
+  // Retain the last fault through OSD polling suspension. A healthy update
+  // does not erase the explanation for an earlier failure.
+  for(p=0;p<2;p=p+1) if(observe && faults[p]) retained_reason[p*2+:2]<=reasons[p*2+:2];
+  if(request==ack_sync && mailbox!=next_sample) begin
+   mailbox<=next_sample;request<=~request;
+  end
+ end
+end
+always @(posedge dst_clk) begin
+ req_meta<=request;req_sync<=req_meta;
+ if(rst) begin received<=EMPTY;ack<=0;req_meta<=0;req_sync<=0;end
+ else if(req_sync!=ack) begin received<=mailbox;ack<=req_sync;end
+end
+endmodule
+`endif
