+// A snapshot holds one complete cycle. Wait for both follow-up events even
+// if a new report arrives before the first vblank. An interrupted measurement
+// is discarded; the most recent complete snapshot survives OSD suspension.
+// Quantization is one microsecond. FFFF is unavailable, FFFE is saturation.
+module llapi_poll_timing(
+    input clk, observe, poll_start, busy_release, status_start, report, vblank_rise,
+    output reg [63:0] snapshot = 64'hffff_ffff_ffff_ffff
+);
+    localparam [2:0] IDLE=0, WAIT_BUSY=1, WAIT_STATUS=2, WAIT_REPORT=3, WAIT_ENDS=4;
+    localparam [15:0] MAX_US=16'hfffe;
+    reg [2:0] phase = IDLE;
+    reg [5:0] divider = 0;
+    reg [15:0] age_us = 0;
+    reg [15:0] poll_us, status_us, next_poll_us, next_vblank_us;
+    reg saw_poll, saw_vblank;
+    wire us_tick = divider == 6'd49;
+    wire [15:0] elapsed = us_tick && age_us < MAX_US ? age_us + 16'd1 : age_us;
+
+    always @(posedge clk) begin
+        if (!observe) begin
+            phase <= IDLE;
+            divider <= 0;
+            age_us <= 0;
+        end else begin
+            divider <= us_tick ? 6'd0 : divider + 6'd1;
+            age_us <= elapsed;
+            case (phase)
+                IDLE: if (poll_start) begin
+                    phase <= WAIT_BUSY;
+                    age_us <= 0;
+                end
+                WAIT_BUSY: if (busy_release) begin
+                    poll_us <= elapsed;
+                    phase <= WAIT_STATUS;
+                    age_us <= 0;
+                end
+                WAIT_STATUS: if (status_start) begin
+                    status_us <= elapsed;
+                    phase <= WAIT_REPORT;
+                end
+                WAIT_REPORT: if (report) begin
+                    phase <= WAIT_ENDS;
+                    age_us <= 0;
+                    saw_poll <= 0;
+                    saw_vblank <= vblank_rise;
+                    next_vblank_us <= 0;
+                end
+                WAIT_ENDS: begin
+                    if (poll_start && !saw_poll) begin
+                        saw_poll <= 1;
+                        next_poll_us <= elapsed;
+                    end
+                    if (vblank_rise && !saw_vblank) begin
+                        saw_vblank <= 1;
+                        next_vblank_us <= elapsed;
+                    end
+                    if ((saw_poll || poll_start) && (saw_vblank || vblank_rise)) begin
+                        snapshot <= {poll_us, status_us, saw_poll ? next_poll_us : elapsed,
+                                     saw_vblank ? next_vblank_us : elapsed};
+                        phase <= poll_start ? WAIT_BUSY : IDLE;
+                        age_us <= 0;
+                    end
+                end
+                default: phase <= IDLE;
+            endcase
+        end
+    end
+endmodule
