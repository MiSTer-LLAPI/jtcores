diff --git a/modules/jtframe/target/mister/hdl/jtframe_serial_arcade.sv b/modules/jtframe/target/mister/hdl/jtframe_serial_arcade.sv
new file mode 100644
index 0000000..44a076f
--- /dev/null
+++ b/modules/jtframe/target/mister/hdl/jtframe_serial_arcade.sv
@@ -0,0 +1,446 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Optional digital SNAC readers for the 1943 LLAPI pilot.
+// USER pin assignments follow MiSTer-devel SNES, Genesis and Saturn cores.
+// Saturn nibble order also checked against Timothy Redaelli's joydb9saturn
+// reader in MiSTer-DB9/jtcores; this is a single-port SNAC implementation.
+module jtframe_serial_arcade #(parameter BUTTONS=3)(
+    input clk_50,clk_sys,rst,vblank,osd_active,repoll_off,
+    input autofire_enable,autofire_toggle,
+`ifdef JTFRAME_ENHANCED_CONTROLS
+    input autofire_enable2,autofire_toggle2,
+    input [1:0] autofire_rate1,autofire_rate2,
+    input loss_resume,
+    output loss_paused,
+    output [1:0] loss_players,
+    output [1:0] loss_countdown,
+    input info_clk,
+    output [19:0] controller_info,
+    output [7:0] link_diagnostics,
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+    output [63:0] poll_timing_us,
+`endif
+    output [3:0] last_fault_reason,
+`endif
+    input [2:0] mode, // 0 LLAPI, 1 Saturn, 2 SEGA, 3 original DB15, 4 SNES, 5 PCE 2-button, 6 NES
+    input [6:0] user_in,
+    output [6:0] user_out,
+    input [15:0] usb1,usb2,
+    output [15:0] joy1,joy2,
+    output [3:0] start,coin,
+    output db15_drive,
+    output osd_request
+);
+    (* async_reg="true" *) reg [2:0] mode_meta=0,mode50=0;
+    reg [2:0] previous_mode=0;
+    reg [12:0] settle=7500;
+    wire ready50=(settle==0) && mode50==previous_mode;
+    always @(posedge clk_50) begin
+        mode_meta<=mode; mode50<=mode_meta;
+        previous_mode<=mode50;
+        if(mode50!=previous_mode) settle<=13'd7500; // 150 us released
+        else if(settle!=0) settle<=settle-1'b1;
+    end
+    wire [6:0] llapi_out,snac_out;
+    wire [15:0] llapi_joy1,llapi_joy2;
+    wire [3:0] llapi_start,llapi_coin;
+    wire llapi_osd;
+    wire [1:0] llapi_af,snac_af,llapi_connected;
+`ifdef JTFRAME_ENHANCED_CONTROLS
+    wire [1:0] llapi_type_changed;
+`endif
+    // With flstory, Hold is enabled only for the loaded two-button cabinet.
+    localparam AF_TWO_BUTTONS =
+`ifdef JTFRAME_FLSTORY_AUTOFIRE
+        1;
+`else
+        BUTTONS == 2;
+`endif
+    jtframe_llapi_arcade #(.BUTTONS(BUTTONS),.AF_TWO_BUTTONS(AF_TWO_BUTTONS)) u_llapi(.repoll_off(repoll_off),
+        .clk_50(clk_50),.clk_sys(clk_sys),.rst(rst),.vblank(vblank),
+        .enable(ready50 && mode50==0),.osd_active(osd_active),
+        .user_in(user_in),.user_out(llapi_out),.usb1(usb1),.usb2(usb2),
+        .joy1(llapi_joy1),.joy2(llapi_joy2),.start(llapi_start),
+        .coin(llapi_coin),.osd_request(llapi_osd),.autofire_hold(llapi_af),.connected(llapi_connected)
+`ifdef JTFRAME_ENHANCED_CONTROLS
+        ,.loss_resume(loss_resume),.loss_paused(loss_paused),.loss_countdown(loss_countdown),.loss_players(loss_players),.info_clk(info_clk),.controller_info(controller_info),.link_diagnostics(link_diagnostics)
+`ifdef JTFRAME_LLAPI_POLL_DIAG
+        ,.poll_timing_us(poll_timing_us)
+`endif
+        ,.last_fault_reason(last_fault_reason),.type_changed(llapi_type_changed)
+`endif
+    );
+    wire [8:0] snac_pad,snac_pad2;
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+    wire [2:0] snac_extra1,snac_extra2;
+`endif
+    wire [2:0] reader_mode=mode50==1 ? 3 : mode50==2 ? 2 : mode50==4 ? 1 : mode50==5 ? 4 : mode50==6 ? 5 : 0;
+    jtframe_snac_arcade #(.BUTTONS(BUTTONS),.AF_TWO_BUTTONS(AF_TWO_BUTTONS)) u_snac(.clk_50(clk_50),
+        .enable(ready50 && reader_mode!=0),.mode(reader_mode),
+        .user_in(user_in),.user_out(snac_out),.pad(snac_pad),.pad2(snac_pad2),.autofire_hold(snac_af)
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+        ,.extra1(snac_extra1),.extra2(snac_extra2)
+`endif
+    );
+    // Only one mux drives the physical connector. Inactive readers cannot
+    // drive pins, and all pins are released while changing protocol.
+    assign db15_drive=ready50 && mode50==3;
+    wire db_clk,db_load;
+    wire [15:0] db1,db2;
+    // Preserve Jotego's original Antonio Villena DB15 splitter reader.
+    joy_db15 u_db15(.clk(clk_50),.JOY_CLK(db_clk),.JOY_LOAD(db_load),
+        .JOY_DATA(user_in[5]),.joystick1(db1),.joystick2(db2));
+    wire [8:0] port1=mode50==3 ? {db1[11:10],db1[6:0]} : snac_pad;
+    wire [8:0] port2=mode50==3 ? {db2[11:10],db2[6:0]} : (mode50==4 || mode50==6) ? snac_pad2 : 9'd0;
+    assign user_out=!ready50 ? 7'h7f : mode50==0 ? llapi_out :
+                    mode50==3 ? {5'h1f,db_clk,db_load} : snac_out;
+    (* async_reg="true" *) reg [8:0] pad_meta=0,pad_sys=0,pad2_meta=0,pad2_sys=0;
+    (* async_reg="true" *) reg [2:0] active_meta=0,active_sys=0;
+    (* async_reg="true" *) reg ready_meta=0,ready_sys=0;
+    always @(posedge clk_sys) begin
+        pad_meta<=port1; pad_sys<=pad_meta;
+        pad2_meta<=port2; pad2_sys<=pad2_meta;
+        active_meta<=mode50; active_sys<=active_meta;
+        ready_meta<=ready50; ready_sys<=ready_meta;
+    end
+    wire stable=ready_sys && active_sys==mode;
+    wire snac_selected=stable && active_sys!=0 && active_sys<=6;
+    wire db15_selected=stable && active_sys==3;
+    wire dual_snac=stable && (active_sys==3 || active_sys==4 || active_sys==6);
+
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+    (* async_reg="true" *) reg [2:0] extra1_meta=0,extra1_sys=0,extra2_meta=0,extra2_sys=0;
+    always @(posedge clk_sys) begin
+        extra1_meta <= mode50==3 ? db1[9:7] : snac_extra1;
+        extra2_meta <= mode50==3 ? db2[9:7] : snac_extra2;
+        extra1_sys <= extra1_meta;
+        extra2_sys <= extra2_meta;
+    end
+`else
+    wire [2:0] extra1_sys=0, extra2_sys=0;
+`endif
+    wire [2:0] game_extra1, game_extra2;
+    wire inhibit;
+    (* async_reg="true" *) reg vblank_meta=0, vblank_sys=0;
+    reg previous_vblank=0;
+    always @(posedge clk_sys) begin
+        vblank_meta <= vblank;
+        vblank_sys <= vblank_meta;
+        previous_vblank <= vblank_sys;
+    end
+    wire snac_frame_tick = vblank_sys && !previous_vblank;
+    wire [6:0] snac_game1, snac_game2;
+    wire [1:0] snac_start, db_menu;
+    jtframe_snac_turbo #(.BUTTONS(BUTTONS)) turbo1(
+        .clk(clk_sys), .reset(rst), .selected(snac_selected), .frame_tick(snac_frame_tick),
+        .osd(inhibit), .extra(extra1_sys), .extra_fire(game_extra1),
+        .pad(pad_sys), .game_pad(snac_game1),
+        .game_start(snac_start[0]), .db15_menu(db_menu[0]));
+    jtframe_snac_turbo #(.BUTTONS(BUTTONS)) turbo2(
+        .clk(clk_sys), .reset(rst), .selected(dual_snac), .frame_tick(snac_frame_tick),
+        .osd(inhibit), .extra(extra2_sys), .extra_fire(game_extra2),
+        .pad(pad2_sys), .game_pad(snac_game2),
+        .game_start(snac_start[1]), .db15_menu(db_menu[1]));
+    wire snac_menu=snac_selected && (db15_selected ?
+        (|db_menu) :
+        ((pad_sys[2] && pad_sys[7] && pad_sys[4]) ||
+         ((active_sys==4 || active_sys==6) && pad2_sys[2] && pad2_sys[7] && pad2_sys[4])));
+    assign inhibit=osd_active || snac_menu;
+    wire [15:0] raw_joy1,raw_joy2;
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+    assign raw_joy1=!stable ? usb1 : !snac_selected ? llapi_joy1 :
+                 inhibit ? 16'd0 : {6'd0,game_extra1,snac_game1};
+    assign raw_joy2=!stable ? usb2 : dual_snac ?
+                 (inhibit ? 16'd0 : {6'd0,game_extra2,snac_game2}) :
+                 snac_selected ? usb1 : llapi_joy2;
+`else
+    assign raw_joy1=!stable ? usb1 : !snac_selected ? llapi_joy1 :
+                 inhibit ? 16'd0 : {9'd0,snac_game1};
+    assign raw_joy2=!stable ? usb2 : dual_snac ?
+                 (inhibit ? 16'd0 : {9'd0,snac_game2}) :
+                 snac_selected ? usb1 : llapi_joy2;
+`endif
+`ifdef JTFRAME_LLAPI_HOLD_AUTOFIRE
+    (* async_reg="true" *) reg [1:0] snac_af_meta=0,snac_af_sys=0;
+    (* async_reg="true" *) reg vb_meta=0,vb_sync=0;
+    always @(posedge clk_sys) begin
+        snac_af_meta<=snac_af;snac_af_sys<=snac_af_meta;
+        vb_meta<=vblank;vb_sync<=vb_meta;
+    end
+    wire [1:0] db_af={db2[7],db1[7]};
+    (* async_reg="true" *) reg [1:0] db_af_meta=0,db_af_sys=0;
+    always @(posedge clk_sys) begin db_af_meta<=db_af;db_af_sys<=db_af_meta;end
+    // Two-button SNAC pads have no spare autofire control. Never consume manual fire.
+    wire autofire_available=active_sys==0 || active_sys==2 || active_sys==3 || active_sys==4 || active_sys==1;
+    wire effective_autofire=autofire_enable && autofire_available;
+    wire [1:0] held=stable && !inhibit ?
+        (active_sys==0 ? llapi_af : (active_sys==4 || active_sys==2 || (active_sys==1 && !AF_TWO_BUTTONS)) ? snac_af_sys : active_sys==1 && AF_TWO_BUTTONS ? {1'b0,pad_sys[6]} : active_sys==3 ? db_af_sys : 2'b0) : 2'b0;
+    wire fire1,fire2;
+`ifdef JTFRAME_ENHANCED_CONTROLS
+    wire [1:0] clear_af={2{!stable}} | ({2{active_sys==0}} & (~llapi_connected | llapi_type_changed));
+    enhanced_autofire af1(clk_sys,rst,vb_sync,held[0],raw_joy1[4],inhibit,
+        effective_autofire,autofire_toggle,clear_af[0],autofire_rate1,fire1);
+    enhanced_autofire af2(clk_sys,rst,vb_sync,held[1],raw_joy2[4],inhibit,
+        autofire_enable2 && autofire_available,autofire_toggle2,clear_af[1],autofire_rate2,fire2);
+`else
+    selectable_autofire af1(clk_sys,rst,vb_sync,held[0],raw_joy1[4],inhibit,effective_autofire,autofire_toggle,!stable || (active_sys==0 && !llapi_connected[0]),fire1);
+    selectable_autofire af2(clk_sys,rst,vb_sync,held[1],raw_joy2[4],inhibit,effective_autofire,autofire_toggle,!stable || (active_sys==0 && !llapi_connected[1]),fire2);
+`endif
+    assign joy1={raw_joy1[15:5],fire1,raw_joy1[3:0]};
+    assign joy2={raw_joy2[15:5],fire2,raw_joy2[3:0]};
+`else
+    assign joy1=raw_joy1;assign joy2=raw_joy2;
+`endif
+    assign start=!stable ? 4'd0 : !snac_selected ? llapi_start :
+                 {2'd0,dual_snac && snac_start[1] && !inhibit,
+                  snac_start[0] && (!pad_sys[8] || db15_selected) && !inhibit};
+    assign coin=!stable ? 4'd0 : !snac_selected ? llapi_coin :
+                 {2'd0,dual_snac && pad2_sys[8] && !inhibit,pad_sys[8] && !inhibit};
+    assign osd_request=stable && (snac_selected ? snac_menu : llapi_osd);
+endmodule
+
+module jtframe_snac_arcade #(
+    parameter BUTTONS=3,
+    parameter TICK_CYCLES=500, // 10 us at 50 MHz; shortened only in simulation
+    parameter SCAN_TICKS=250, // 2.5 ms; allows MD six-button timeout to reset
+    parameter AF_TWO_BUTTONS=(BUTTONS==2)
+)(
+    input clk_50,enable,
+    input [2:0] mode, // 1 SNES, 2 Mega Drive, 3 Saturn digital, 4 PCE, 5 NES
+    input [6:0] user_in,
+    output reg [6:0] user_out=7'h7f,
+    // [8] coin, [7] start, [6:4] buttons, [3:0] UDLR, active high
+    output reg [1:0] autofire_hold=0,
+    output reg [8:0] pad=0,pad2=0
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+    ,output reg [2:0] extra1=0,extra2=0
+`endif
+);
+    (* async_reg="true" *) reg [6:0] input_meta=7'h7f,input_sync=7'h7f;
+    always @(posedge clk_50) begin input_meta<=user_in; input_sync<=input_meta; end
+    localparam TICK_WIDTH=TICK_CYCLES<2 ? 1 : $clog2(TICK_CYCLES);
+    reg [TICK_WIDTH-1:0] ticks=0;
+    reg [10:0] phase=0;
+    reg [2:0] old_mode=0;
+    reg [7:0] nes=8'hff,nes2=8'hff;
+    reg [3:0] pce_dir=4'hf,pce_buttons=4'hf;
+    // About 60 Hz CLR cadence preserves the purpose of physical PCE turbo switches.
+    localparam PCE_SCAN_TICKS=1667;
+    reg [15:0] snes=16'hffff,snes2=16'hffff;
+    reg [5:0] md_high=6'h3f;
+    reg [1:0] md_as=2'b11;
+    reg md_valid=0,md_six=0;
+    reg [3:0] md_extra=4'hf;
+    reg [3:0] sat_extra=4'hf,sat_main=4'hf,sat_dir=4'hf;
+    wire [5:0] md_in={input_sync[6],input_sync[2],input_sync[3],input_sync[5],input_sync[0],input_sync[1]}; // C B R L D U
+    wire [3:0] sat_in={input_sync[3],input_sync[5],input_sync[0],input_sync[1]}; // D3..D0
+    always @(posedge clk_50) begin
+        old_mode<=mode;
+        if(!enable || mode==0 || mode>5 || mode!=old_mode) begin
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+            extra1<=0; extra2<=0;
+`endif
+            autofire_hold<=0; ticks<=0; phase<=0; user_out<=7'h7f; pad<=0; pad2<=0;
+            nes<=8'hff;nes2<=8'hff;pce_dir<=4'hf;pce_buttons<=4'hf;
+            snes<=16'hffff; snes2<=16'hffff; md_valid<=0; md_six<=0;
+            md_high<=6'h3f; md_as<=2'b11; md_extra<=4'hf;
+            sat_extra<=4'hf; sat_main<=4'hf; sat_dir<=4'hf;
+        end else if(ticks==TICK_CYCLES-1) begin
+            ticks<=0;
+            phase<=phase==(mode==4 ? PCE_SCAN_TICKS-1 : SCAN_TICKS-1) ? 0 : phase+1'b1;
+            case(mode)
+                4: begin
+                    // MiSTer-devel TG16: SEL=USER2, CLR=USER4,
+                    // D0..D3=USER1,0,5,3. Two-button direct adapter only.
+                    case(phase)
+                        0: begin user_out<=7'h7f; autofire_hold<=0;pad2<=0; end
+                        1: user_out[4]<=0; // release CLR; SEL high selects U,R,D,L
+                        2: begin pce_dir<=sat_in;user_out[2]<=0;end
+                        3: pce_buttons<=sat_in; // SEL low selects I,II,Select,Run
+                        4: pad<={~pce_buttons[2],~pce_buttons[3],1'b0,
+                                  ~pce_buttons[1],~pce_buttons[0],
+                                  ~pce_dir[0],~pce_dir[2],~pce_dir[3],~pce_dir[1]};
+                    endcase
+                end
+                5: begin
+                    // NES: latch USER0; P1 clock/data USER1/5, P2 USER3/6.
+                    // Sample the current bit while clock low, then advance on rising edge.
+                    if(phase==0) begin user_out<=7'h75;nes<=8'hff;nes2<=8'hff;autofire_hold<=0;end
+                    if(phase==1) user_out[0]<=0;
+                    if(phase>=2 && phase<=16 && !phase[0]) begin
+                        nes[(phase-2)>>1]<=input_sync[5];
+                        nes2[(phase-2)>>1]<=input_sync[6];
+                        user_out[1]<=1;user_out[3]<=1;
+                    end
+                    if(phase>=3 && phase<=17 && phase[0]) begin user_out[1]<=0;user_out[3]<=0;end
+                    if(phase==18) begin
+                        pad<={~nes[2],~nes[3],1'b0,~nes[1],~nes[0],~nes[4],~nes[5],~nes[6],~nes[7]};
+                        pad2<={~nes2[2],~nes2[3],1'b0,~nes2[1],~nes2[0],~nes2[4],~nes2[5],~nes2[6],~nes2[7]};
+                    end
+                end
+                1: begin
+                    // Official SNES dual-port SNAC: shared latch USER0,
+                    // P1 clock/data USER1/5, P2 clock/data USER3/6.
+                    // Sample before each falling edge; controller advances
+                    // on that edge, leaving a full period for the next bit.
+                    if(phase==0 || phase==1) begin user_out<=7'h7f; snes<=16'hffff; snes2<=16'hffff; end
+                    if(phase==2) user_out[0]<=0;
+                    if(phase>=3 && phase<=33 && phase[0]) begin
+                        snes[(phase-3)>>1]<=input_sync[5];
+                        snes2[(phase-3)>>1]<=input_sync[6];
+                        user_out[1]<=0; user_out[3]<=0;
+                    end
+                    if(phase>=4 && phase<=34 && !phase[0]) begin user_out[1]<=1; user_out[3]<=1; end
+                    if(phase==35) begin
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+                        extra1<=snes[15:12]==4'hf ? ~{snes[11:10],snes[9]} : 3'd0;
+                        extra2<=snes2[15:12]==4'hf ? ~{snes2[11:10],snes2[9]} : 3'd0;
+`endif
+                        autofire_hold<={(snes2[15:12]==4'hf)&&!snes2[9],(snes[15:12]==4'hf)&&!snes[9]};
+                        if(snes[15:12]==4'hf)
+                            pad<={~snes[2],~snes[3],~snes[1],~snes[8],~snes[0],~snes[4],~snes[5],~snes[6],~snes[7]};
+                        else pad<=0;
+                        if(snes2[15:12]==4'hf)
+                            pad2<={~snes2[2],~snes2[3],~snes2[1],~snes2[8],~snes2[0],~snes2[4],~snes2[5],~snes2[6],~snes2[7]};
+                        else pad2<=0;
+                    end
+                end
+                2: begin
+                    // Mega Drive: TH=USER4. Other pins remain released inputs.
+                    case(phase)
+                        0: begin user_out<=7'h6f; md_six<=0; md_extra<=4'hf; end
+                        1: user_out[4]<=1;
+                        2: begin md_high<=md_in; user_out[4]<=0; end
+                        3: begin md_as<=md_in[5:4]; md_valid<=(md_in[3:2]==0); user_out[4]<=1; end
+                        4: user_out[4]<=0;
+                        5: begin md_six<=(md_in[3:0]==0); user_out[4]<=1; end
+                        6: begin md_extra<=md_in[3:0]; user_out[4]<=0; end
+                        7: begin
+                            user_out[4]<=1;
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+                            extra1<=md_valid && md_six ? ~{md_extra[0],md_extra[1],md_extra[2]} : 3'd0;
+`endif
+                            // MD6 X is separate from ABC/Mode/Start and only
+                            // valid after the extension handshake; MD3 has no X.
+                            autofire_hold<={1'b0,md_valid && (md_six ? !md_extra[2] : AF_TWO_BUTTONS && !md_high[5])};
+                            if(md_valid) begin
+                                pad[3:0]<=~{md_high[0],md_high[1],md_high[2],md_high[3]};
+                                pad[6:4]<=~{md_high[5],md_as[0],md_high[4]}; // C,A,B => buttons 3,2,1
+                                pad[7]<=~md_as[1];
+                                // Mode on a 6-button pad; Down+Start also
+                                // works on a 3-button pad (consumes Start).
+                                pad[8]<=(md_six && !md_extra[3]) || (!md_high[1] && !md_as[1]);
+                            end else pad<=0;
+                        end
+                    endcase
+                end
+                3: begin
+                    // Saturn digital: TH=USER4, TR=USER6; D3..0 use
+                    // USER3,5,0,1. TL/USER2 is released (input).
+                    case(phase)
+                        0: user_out<=7'h2f; // TH=0, TR=0
+                        1: begin sat_extra<=sat_in; user_out[4]<=1; end
+                        2: begin sat_main<=sat_in; user_out[4]<=0; user_out[6]<=1; end
+                        3: begin sat_dir<=sat_in; user_out[4]<=1; end
+                        4: begin
+                            // Digital pad ID: final phase is {L,1,0,0}.
+                            // Reject an analog-handshake pad instead of
+                            // retaining stale data or inventing button presses.
+                            // Extra nibble is {R,X,Y,Z}.
+`ifdef JTFRAME_LLAPI_EXTRA_ACTIONS
+                            extra1<=sat_in[2:0]==3'b100 ? ~{sat_extra[0],sat_extra[1],sat_extra[2]} : 3'd0;
+`endif
+                            autofire_hold <= {1'b0, sat_in[2:0]==3'b100 && !sat_extra[2]};
+                            if(sat_in[2:0]==3'b100) begin
+                                pad[3:0]<=~{sat_dir[0],sat_dir[1],sat_dir[2],sat_dir[3]};
+                                pad[6:4]<=~{sat_main[2],sat_main[1],sat_main[0]}; // A,C,B
+                                pad[7]<=~sat_main[3];
+                                pad[8]<=~sat_in[3]; // L inserts coin
+                            end else pad<=0;
+                        end
+                    endcase
+                end
+            endcase
+        end else ticks<=ticks+1'b1;
+    end
+endmodule
+
+
+`ifdef JTFRAME_LLAPI_HOLD_AUTOFIRE
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Frame-based hold-to-fire pulse generator; map the physical button upstream.
+module hold_autofire #(parameter HALF_PERIOD_FRAMES=3)(
+ input clk,rst,frame,hold_button,manual_fire,inhibit,
+ output fire
+);
+localparam CW=HALF_PERIOD_FRAMES<2 ? 1 : $clog2(HALF_PERIOD_FRAMES);
+reg [CW-1:0] count=0;
+reg phase=1,previous_frame=0;
+always @(posedge clk) begin
+ previous_frame<=frame;
+ if(rst || inhibit || !hold_button) begin count<=0;phase<=1;end
+ else if(frame && !previous_frame) begin
+  if(count==HALF_PERIOD_FRAMES-1) begin count<=0;phase<=~phase;end
+  else count<=count+1'b1;
+ end
+end
+assign fire=!rst && !inhibit && (manual_fire || (hold_button && phase));
+endmodule
+
+`endif
+
+// Configurable autofire. Settings/OSD/interface changes clear the latch.
+// A button held during a clear must be released before it can toggle again.
+module selectable_autofire #(parameter HALF_PERIOD_FRAMES=3)(
+ input clk,rst,frame,button,manual_fire,inhibit,enable,toggle_mode,clear,
+ output fire
+);
+reg latched=0,previous_button=0,armed=0,previous_enable=0,previous_mode=0;
+wire config_change=(enable!=previous_enable)||(toggle_mode!=previous_mode);
+wire cancel=rst||inhibit||clear||!enable||config_change;
+always @(posedge clk) begin
+ previous_enable<=enable;previous_mode<=toggle_mode;previous_button<=button;
+ if(cancel) begin latched<=0;armed<=0;end
+ else begin
+  if(!button) armed<=1;
+  if(toggle_mode && armed && button && !previous_button) latched<=~latched;
+ end
+end
+wire active=enable && !clear && !config_change && (toggle_mode ? latched : button);
+hold_autofire #(.HALF_PERIOD_FRAMES(HALF_PERIOD_FRAMES)) pulse(clk,rst,frame,active,manual_fire,inhibit,fire);
+endmodule
+
+`ifdef JTFRAME_ENHANCED_CONTROLS
+// SPDX-License-Identifier: GPL-3.0-or-later
+// UltimateMiSTer integration: independent, frame-paced player autofire.
+// rate: 0 = 6-frame period, 1 = 12-frame period, 2 = 4-frame period.
+// Reserved rate 3 uses the default period. No physical Hz claim is made.
+module enhanced_autofire(
+ input clk,rst,frame,button,manual_fire,inhibit,enable,toggle_mode,clear,
+ input [1:0] rate,
+ output fire
+);
+reg previous_frame=0,previous_button=0,previous_enable=0,previous_mode=0;
+reg [1:0] previous_rate=0;
+reg latched=0,armed=0,phase=1;
+reg [2:0] count=0;
+wire config_change=enable!=previous_enable || toggle_mode!=previous_mode || rate!=previous_rate;
+wire cancel=rst || inhibit || clear || !enable || config_change;
+wire active=!cancel && armed && (toggle_mode ? latched : button);
+wire [2:0] last_count=rate==1 ? 3'd5 : rate==2 ? 3'd1 : 3'd2;
+always @(posedge clk) begin
+ previous_frame<=frame; previous_button<=button;
+ previous_enable<=enable; previous_mode<=toggle_mode; previous_rate<=rate;
+ if(cancel) begin latched<=0;armed<=0; end
+ else begin
+  if(!button) armed<=1;
+  if(toggle_mode && armed && button && !previous_button) latched<=~latched;
+ end
+ if(!active) begin count<=0;phase<=1;end
+ else if(frame && !previous_frame) begin
+  if(count==last_count) begin count<=0;phase<=~phase;end
+  else count<=count+1'b1;
+ end
+end
+assign fire=!rst && !inhibit && (manual_fire || (active && phase));
+endmodule
+`endif
