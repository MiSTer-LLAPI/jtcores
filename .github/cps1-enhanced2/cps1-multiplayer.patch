+`ifdef JTFRAME_CPS1_MULTIPLAYER_AUTOFIRE
+// Select the control profile from the CPS1.5 ROM header.
+// Select the control profile from the CPS1 ROM header.
+module cps1_autofire_profile(
+    input wire [7:0] header16, header34, header39,
+    output reg player3, player4, attack_b2
+);
+    always @* begin
+        player3 = 0;
+        player4 = 0;
+        attack_b2 = 0;
+        case ({header16, header34, header39})
+            24'hff0404: begin player3 = 1; player4 = 1; end // captcomm
+            24'hff0d02: begin player3 = 1; player4 = 0; end // knights
+            24'h201302: begin player3 = 1; player4 = 0; end // mercs
+            24'hff0b03: begin player3 = 1; player4 = 0; end // kod
+            default: ;
+        endcase
+    end
+endmodule
+
+// ROM headers arrive in ascending address order in the download clock domain.
+// Clear the previous game's profile as soon as the next ROM starts.
+module cps1_autofire_header(
+    input wire clk_rom, ioctl_rom, ioctl_wr,
+    input wire [26:0] ioctl_addr,
+    input wire [7:0] ioctl_dout,
+    output reg [2:0] profile = 3'b000
+);
+    reg [7:0] header16, header34;
+    reg [1:0] received = 2'b00;
+    wire [2:0] decoded;
+    cps1_autofire_profile decode(header16, header34, ioctl_dout,
+        decoded[2], decoded[1], decoded[0]);
+    always @(posedge clk_rom) begin
+        if (!ioctl_rom) received <= 0;
+        else if (ioctl_wr) begin
+            case (ioctl_addr)
+                0: begin received <= 0; profile <= 0; end
+                16: begin header16 <= ioctl_dout; received[0] <= 1; end
+                34: begin header34 <= ioctl_dout; received[1] <= 1; end
+                39: begin profile <= (&received) ? decoded : 3'b000; received <= 0; end
+            endcase
+        end
+    end
+endmodule
+module cps1_usb_autofire(
+    input clk, rst, frame, osd, second_action, enable,
+    input [1:0] rate,
+    input [15:0] pad,
+    output [15:0] game_pad
+);
+    wire held = second_action ? pad[5] : pad[4];
+    wire pulse;
+    enhanced_autofire repeat_action(clk, rst, frame, held, 1'b0, osd,
+        enable, 1'b0, 1'b0, rate, pulse);
+    wire [15:0] action_mask = second_action ? 16'h0020 : 16'h0010;
+    assign game_pad = enable ? ((pad & ~action_mask) | (pulse ? action_mask : 16'd0)) : pad;
+endmodule
+`endif
